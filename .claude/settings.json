{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "PowerShell(npm run *)",
      "Bash(npx tsc *)",
      "PowerShell(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx next lint *)",
      "PowerShell(npx next lint *)",
      "PowerShell(npx prisma generate *)",
      "Bash(node ./node_modules/typescript/bin/tsc *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/guard-prod.mjs" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/stop-verify.mjs" }
        ]
      }
    ]
  }
}
