# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# python (venv + bytecode — never commit; recreate with scripts/requirements.txt)
.venv/
venv/
__pycache__/
*.pyc

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next-dev.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# large binary assets (host elsewhere or use LFS)
/public/bsk-stem.zip

# Lyrics ingestion working files (may contain full lyrics — never commit)
lyric-candidates.json
lyrics-review.json
.mxm-token.json

# Playwright MCP scratch (screenshots, snapshots, console logs)
.playwright-mcp/

# Claude Code local tooling / config (machine-specific — not shared).
# The rest of .claude/ (settings.json, agents, commands, hooks) IS shared.
.mcp.json
.superpowers/
.claude/settings.local.json

# Genius manual-add paste-pack helper (generated locally for copy/paste ingest)
genius-add-pack.html
orphaned-audio-manifest-*.json
